# Shared secret — the frontend (Vercel) must send this in Authorization: Bearer.
# Generate something like: openssl rand -hex 32
WORKER_TOKEN=replace-with-long-random-secret

# Supabase service role key — bypasses RLS so the worker can insert leads
# under any user_id. NEVER expose this client-side.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Google Places API (New) — required for the place-lookup step.
# Get one at https://console.cloud.google.com → APIs & Services → Credentials.
# Enable "Places API (New)" on the project first. Restrict the key to that API.
GOOGLE_MAPS_API_KEY=AIzaSy...

# Optional: Mistral API for AI keyword expansion. Falls back to a hardcoded
# niche map if not set.
# MISTRAL_API_KEY=...

# Outreach autopilot sender — first configured wins.
#
# Option A: Gmail SMTP (no domain needed — works on free Gmail, ~500/day cap).
#   1. Enable 2-Step Verification on your Google account.
#   2. Generate an App Password at https://myaccount.google.com/apppasswords
#      (16 chars, no spaces). It is NOT your regular password.
#   3. Set both vars below. From address will be GMAIL_USER.
# GMAIL_USER=you@gmail.com
# GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
#
# Option B: Resend HTTP API (requires a verified sending domain).
# RESEND_API_KEY=re_...
# OUTREACH_FROM=Your Name <outreach@yourdomain.com>
# MAIL_FROM=Lead Machine <hello@yourdomain.com>
#
# If neither is set the tick logs to stdout instead of sending — UI works,
# nothing actually goes out.

# Port — Railway sets this automatically
PORT=8080
