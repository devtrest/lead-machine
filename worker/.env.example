# Shared secret — the frontend (Vercel) must send this in Authorization: Bearer.
# Generate something like: openssl rand -hex 32
WORKER_TOKEN=replace-with-long-random-secret

# Supabase service role key — bypasses RLS so the worker can insert leads
# under any user_id. NEVER expose this client-side.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Google Places API (New) — required for the place-lookup step.
# Get one at https://console.cloud.google.com → APIs & Services → Credentials.
# Enable "Places API (New)" on the project first. Restrict the key to that API.
GOOGLE_MAPS_API_KEY=AIzaSy...

# Optional: Mistral API for AI keyword expansion. Falls back to a hardcoded
# niche map if not set.
# MISTRAL_API_KEY=...

# Outreach autopilot — required for the 15-min tick to actually send.
# Without RESEND_API_KEY, the tick logs to console (UI still testable but
# no real emails go out). OUTREACH_FROM must be a verified address on a
# Resend-verified domain; falls back to MAIL_FROM, then to a placeholder.
# RESEND_API_KEY=re_...
# OUTREACH_FROM=Your Name <outreach@yourdomain.com>
# MAIL_FROM=Lead Machine <hello@yourdomain.com>

# Port — Railway sets this automatically
PORT=8080
