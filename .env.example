# Supabase — required
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Must be the "anon" / "public" JWT (long string starting with eyJ)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Public app URL — used for Stripe redirects + email links
# In production: your real domain (e.g. https://leadmachine.app)
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Worker service (Railway) — when set, the scrape route proxies to the
# Railway worker instead of running Puppeteer in-process. Leave blank for
# local dev (uses embedded scraper).
# WORKER_URL=https://lead-machine-worker.up.railway.app
# WORKER_TOKEN=<same secret you set on the worker>

# Google Places API (New) — required for the place-lookup step.
# Get one at https://console.cloud.google.com → APIs & Services → Credentials.
# Enable "Places API (New)" on the project first. Restrict the key to that API.
# Dev mode (no WORKER_URL) calls Places API directly from this Next.js process,
# so this var is needed locally too.
GOOGLE_MAPS_API_KEY=AIzaSy...

# Stripe — fill in when wiring up billing
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_STARTER=price_...
# STRIPE_PRICE_PREMIUM=price_...
# STRIPE_PRICE_PRO=price_...

# Supabase service role — required only by the Stripe webhook
# SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Email via Resend (optional — without it the mailer logs to console)
# RESEND_API_KEY=re_...
# MAIL_FROM=Nichely <hello@yourdomain.com>

# Optional: server-side Google Places API (for the /api/leads/discover dev route)
# GOOGLE_MAPS_API_KEY=your-google-maps-api-key
# LEADS_API_BEARER=replace-with-long-random-secret

# Optional: comma-separated emails that should become admin on signup
# (otherwise promote manually in Supabase profiles table)
# ADMIN_EMAILS=you@company.com
